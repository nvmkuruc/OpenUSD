class "PhysicsDeformableRestShapeAPI" (
    doc = "Defines the rest shape for a UsdGeomTetMesh."
)
{
    point3f[] physics:restShapePoints (
        doc = "Describes shape in (local) space for a PhysicsDeformable."
    )
    int4[] physics:restTetIndices (
        doc = """Per tetrahedral element indices into restTetIndices to describe
        the rest shape of each tetrahedron. This allows for restTetIndices to
        have length up to 4*len(restShapePoints) to allow for disjoint per-element rest shape description, or a more compact array when all tetrahedra share
        conincident points to describe the rest shape of the PhysicsDeformable tetmesh."""
    )
}

class "PhysicsSurfaceDeformableRestShapeAPI" (
    doc = "Defines the rest shape for a UsdGeomMesh. The UsdGeomMesh needs to contain only triangular faces."
)
{
    float[] physics:edgeBendAngles (
        doc = """Per-edge rest angles in degrees. Length of edgeBendAngles
                 should match length of edgeVertPairs.
                 Range: [-180.0, 180.0)"""
    )
    int2[] physics:edgeVertPairs (
        doc = """Pairs of vertex indices used to identify specific edges in
                 a triangle mesh to set using edgeBendAngles."""
    )
    int3[] physics:restFaceIndices (
        doc = """Per triangle element indices into restShapePoints to describe
                 the rest shape of each triangle face. This allows for
                 restFaceIndices to have length up to 4*len(restShapePoints) to
                 allow for a disjoint per-element rest shape description, or a
                 more compact array when all tetrahedra share conincident points
                 to describe the rest shape of the PhysicsDeformable tetmesh."""
    )
    point3f[] physics:restShapePoints (
        doc = """Describes per triangle planar shape in (local) space for a
                 SurfaceDeformable. While panel based cloth systems may only
                 require UV coordinates and not require a third component,
                 doing so makes it convenient to for an application to
                 support non-planar shells with a rest shape described in 3D.
                 One can still use this array for per-face UVs with a little
                 wasted space."""
    )
}

class "PhysicsCurveDeformableRestShapeAPI" (
    doc = "Defines the rest shape for a UsdGeomBasisCurves or a UsdGeomBasisCurvesNetwork. The curve primitive needs to be composed of linear segments."
)
{
    int[] physics:restCurveVertexIndices (
        doc = """If the shape is a UsdGeomBasisCurvesNetwork, restCurveVertexIndices
        specifies a flat list of the index into the restPoints attribute of each
        vertex of each curve. This allows restCurveVertexIndices to describe a
        disjoint per-curve rest shape that differs from any coincident points
        described by curveVertexIndices. If the deformable is a UsdGeomBasisCurves,
        then restCurveVertexIndices is not applicable."""
    )
    normal3f[] physics:restNormals (
        doc = """Describes the orientation of the rest curves.
        Like normals, restNormals is not a generic primvar but the number of elements
        in this attribute will be determined by its 'interpolation'. See
        For example, varying interpolation can
        be used to specify a normal per curve segment, as described by
        \\ref UsdGeomBasisCurves_PrimvarInterpolation."""
    )
    point3f[] physics:restPoints (
        doc = "Describes the rest shape in (local) space for a UsdGeomBasisCurves or a UsdGeomBasisCurvesNetwork."
    )
}

class PhysicsVtxVtxAttachment "PhysicsVtxVtxAttachment" (
    doc = """Describes a fixed binding attachment between vertices of two
             suitable deformable body simulation meshes. The length of
             vtxIndices1 should always equal that of vtxIndices2. To express
             multiple connections to the same vertex, use multiple instances
             of PhysicsVtxVtxAttachment."""
)
{
    bool physics:attachmentEnabled = 1 (
        displayName = "Attachment Enabled"
        doc = "Determines if this PhysicsVtxVtxAttachment is enabled."
    )
    float physics:damping = 0 (
        displayName = "Damping"
        doc = """Proportional factor of the force acting against the direction
                 of relative motion.
            Range: [0, inf)
            Units: mass/second"""
    )
    float physics:stiffness = inf (
        displayName = "Stiffness"
        doc = '''Distance proportional factor for the attachment.
            "inf" implies a hard constraint when the simulator can support it.
            Range: [0, inf)
            Units: mass/second/second.'''
    )
    int[] physics:vtxIndices0 (
        displayName = "Vertex Indices0"
        doc = "Array of vertex indices from vtxSrc0. "
    )
    int[] physics:vtxIndices1 (
        displayName = "Vertex Indices1"
        doc = "Array of vertex indices from vtxSrc1."
    )
    rel physics:vtxSrc1 (
        displayName = "Vertex Source0"
        doc = """Relationship to a single UsdGeomPointBased the vertices
                 belongs to. This should always point to a deformable body's simulation mesh."""
    )
    rel physics:vtxSrc2 (
        displayName = "Vertex Source2"
        doc = """Relationship to a single UsdGeomPointBased the vertices
                 belongs to. This should always point to a deformable body's simulation mesh."""
    )
    rel proxyPrim (
        doc = '''The proxyPrim relationship allows us to link a
        prim whose purpose is "render" to its (single target)
        purpose="proxy" prim.  This is entirely optional, but can be
        useful in several scenarios:
        
        - In a pipeline that does pruning (for complexity management)
        by deactivating prims composed from asset references, when we
        deactivate a purpose="render" prim, we will be able to discover
        and additionally deactivate its associated purpose="proxy" prim,
        so that preview renders reflect the pruning accurately.
        
        - DCC importers may be able to make more aggressive optimizations
        for interactive processing and display if they can discover the proxy
        for a given render prim.
        
        - With a little more work, a Hydra-based application will be able
        to map a picked proxy prim back to its render geometry for selection.

        \\note It is only valid to author the proxyPrim relationship on
        prims whose purpose is "render".'''
    )
    uniform token purpose = "default" (
        allowedTokens = ["default", "render", "proxy", "guide"]
        doc = """Purpose is a classification of geometry into categories that 
        can each be independently included or excluded from traversals of prims 
        on a stage, such as rendering or bounding-box computation traversals.

        See for more detail about how 
        purpose is computed and used."""
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
        doc = '''Visibility is meant to be the simplest form of "pruning" 
        visibility that is supported by most DCC apps.  Visibility is 
        animatable, allowing a sub-tree of geometry to be present for some 
        segment of a shot, and absent from others; unlike the action of 
        deactivating geometry prims, invisible geometry is still 
        available for inspection, for positioning, for defining volumes, etc.'''
    )
}

class PhysicsVtxTriAttachment "PhysicsVtxTriAttachment" (
